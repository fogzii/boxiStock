// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id        String     @id @default(cuid())
  userId    String     // Clerk User ID
  name      String
  lots      StockLot[]
  sales     Sale[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model StockLot {
  id                String      @id @default(cuid())
  productId         String
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotIdentity       String?     // Optional user-defined lot identity
  initialQuantity   Int
  remainingQuantity Int         // Used for FIFO logic
  buyPrice          Float       // Price per unit
  isStocked         Boolean     @default(false)
  dateAcquired      DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Sale {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantitySold   Int
  totalSalePrice Float
  totalProfit    Float    // Calculated automatically via FIFO
  dateSold       DateTime @default(now())
  createdAt      DateTime @default(now())
}
