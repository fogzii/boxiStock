# Supabase Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only Supabase Secret API key (prefixed `sb_secret_`). Bypasses RLS.
# Never expose to the browser and never prefix with NEXT_PUBLIC_. Get it from:
# Supabase Dashboard -> Project Settings -> API Keys -> Secret keys -> Create new secret key.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Clerk Auth Variables
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Direct Database URL (used for direct DB connections)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Anthropic Claude — AI import (Haiku 4.5 + structured outputs)
ANTHROPIC_API_KEY=""

# Upstash Redis (global rate limiting via @upstash/ratelimit).
# Get both from Upstash Console -> your Redis database -> "REST API" tab.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Resend — contact form email delivery (resend.com)
# Get your API key from: Resend Dashboard -> API Keys
# From address: use "onboarding@resend.dev" for testing, or a verified custom domain for production
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# PostHog — product analytics (posthog.com)
# Get your project API key from: PostHog Dashboard -> Project Settings -> Project API key
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

