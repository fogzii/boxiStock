# Copy to .env.local and fill in the blanks. .env.local is gitignored.
#
# Supabase variables below are the fixed local-dev values `supabase start`
# always produces from this repo's committed supabase/config.toml (same on
# every machine) - safe to commit, only reachable at 127.0.0.1.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Anthropic Claude (AI import) - get your own key from console.anthropic.com
ANTHROPIC_API_KEY=

# Upstash Redis (global rate limiting via @upstash/ratelimit)
# Get both from Upstash Console -> your Redis database -> "REST API" tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend - contact form email delivery (resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_D9V3WssGvLYb8XBHFXTh2m9dzuG8C6kKsnFiD6jvVyNM
