# Copy to .env.local and fill in the blanks. .env.local is gitignored.
#
# Local Supabase URL is fixed. Keys are printed by `npx supabase status`
# after `npm run supabase:start` / `npm run dev` (Publishable = anon,
# Secret = service role). Do not commit real key values - GitHub push
# protection blocks `sb_secret_*` even for local demo keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Anthropic Claude (AI import) - get your own key from console.anthropic.com
ANTHROPIC_API_KEY=

# Upstash Redis (global rate limiting via @upstash/ratelimit)
# Get both from Upstash Console -> your Redis database -> "REST API" tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend - contact form email delivery (resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL="onboarding@resend.dev"

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog Error Tracking source maps (server-only, used at `next build`).
# Personal API key: https://us.posthog.com/settings/user-api-keys
# Choose the "Source map upload" preset. Also set both on Vercel so
# production builds upload maps automatically.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=396915
